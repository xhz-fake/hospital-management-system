<!--pages/appointment/appointment.wxml-->
<view class="container">
  <!-- a.医生信息框 -->
  <view class="doctor-info-card">
    <text class="doctor-name">{{doctorName}}</text>
    <text class="doctor-title">{{departmentName}}</text>
  </view>

  <!-- b.挂号信息框 -->
  <view class="appointment-info">
    <view class="info-item">
      <text class="label">预约时间：</text>
      <text class="value">{{appointmentDate}} {{timeSlot}}</text>
    </view>
    <view class="info-item">
      <text class="label">费用：</text>
      <text class="value price">91元</text>
    </view>
  </view>

  <!-- c.就诊人选择轮盘 -->
  <view class="patient-selector">
    <text class="section-title">选择就诊人</text>
    <scroll-view class="patient-scroll" scroll-x="true">
      <view class="patient-option {{selectedPatientId === item.id ? 'active' : ''}}"
            wx:for="{{patients}}" wx:key="id"
            bindtap="selectPatient" data-patient="{{item}}">
        <text class="patient-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- d.患者信息框 -->
  <view class="patient-info" wx:if="{{selectedPatient}}">
    <view class="info-row">
      <text class="label">患者号：</text>
      <text class="value">{{selectedPatient.idCard}}</text>
    </view>
    <view class="info-row">
      <text class="label">手机号：</text>
      <text class="value">{{selectedPatient.phone}}</text>
    </view>
  </view>

  <!-- e.支付方式选择框 -->
  <view class="payment-method">
    <text class="section-title">支付方式</text>
    <view class="payment-item">
      <image class="payment-icon" src="../../assets/icons/wechat-pay.png"></image>
      <text>微信支付</text>
      <text class="check-icon">✓</text>
    </view>
  </view>

  <!-- f.确定预约按钮 -->
  <view class="submit-btn" bindtap="confirmAppointment">
    <text>确定预约</text>
  </view>
</view>

