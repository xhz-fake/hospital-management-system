/* pages/appointment/appointment.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.doctor-info-card {
  background: linear-gradient(135deg, #0b988f 0%, #0a7d75 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  margin-bottom: 30rpx;
}

.doctor-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.doctor-title {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

.appointment-info,
.patient-info {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.info-item,
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child,
.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.price {
  color: #ff4d4f;
  font-weight: bold;
}

.patient-selector {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.patient-scroll {
  white-space: nowrap;
}

.patient-option {
  display: inline-block;
  padding: 20rpx 40rpx;
  margin-right: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.patient-option.active {
  border-color: #0b988f;
  background-color: #0b988f;
  color: #fff;
}

.payment-method {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.payment-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #0b988f;
  border-radius: 8rpx;
}

.payment-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.payment-item text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.check-icon {
  color: #0b988f;
  font-size: 32rpx;
}

.submit-btn {
  background-color: #0b988f;
  color: #fff;
  text-align: center;
  padding: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
}

