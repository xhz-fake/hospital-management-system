/* pages/departmentList/departmentList.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.search-box {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.search-input {
  width: 100%;
  height: 60rpx;
  font-size: 28rpx;
}

.department-list {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.department-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.department-item:last-child {
  border-bottom: none;
}

.department-name {
  font-size: 32rpx;
  color: #333;
}

.outpatient-btn {
  background-color: #0b988f;
  color: #fff;
  padding: 15rpx 30rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

