/* pages/myAppointments/myAppointments.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.patient-selector {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.appointment-list {
  height: calc(100vh - 250rpx);
}

.appointment-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.status-badge {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
}

.status-badge.pending {
  background-color: #ff9800;
}

.status-badge.completed {
  background-color: #4caf50;
}

.status-badge.cancelled {
  background-color: #999;
}

.appointment-content {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.doctor-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.appointment-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.doctor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.department,
.patient-name,
.time,
.fee,
.order-number,
.location {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.action-buttons {
  text-align: right;
}

.cancel-btn {
  background-color: #ff4d4f;
  color: #fff;
  padding: 15rpx 40rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

