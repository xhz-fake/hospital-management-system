/* pages/doctorList/doctorList.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.filter-item {
  flex: 1;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 24rpx;
}

.doctor-list {
  height: calc(100vh - 300rpx);
}

.doctor-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.doctor-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.doctor-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.doctor-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.doctor-title {
  font-size: 26rpx;
  color: #0b988f;
  margin-bottom: 10rpx;
}

.doctor-department {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.doctor-expertise {
  font-size: 24rpx;
  color: #999;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  width: 80%;
  max-height: 60%;
  overflow-y: auto;
}

.modal-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #e0e0e0;
  font-size: 28rpx;
  color: #333;
}

.modal-item:last-child {
  border-bottom: none;
}

