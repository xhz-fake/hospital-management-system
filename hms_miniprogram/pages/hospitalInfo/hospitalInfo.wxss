/* pages/hospitalInfo/hospitalInfo.wxss */
.container {
  height: 100vh;
  background-color: #f5f5f5;
}

/*轮播图区域样式*/
.swiper {
  border-radius: 10rpx;
  overflow: hidden;
}

.swiper swiper {
  height: 360rpx;
  background-color: rgb(255, 255, 255);
}

.swiper swiper swiper-item image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

/*滚动条*/
.scroll-y {
  height: calc(100vh - 360rpx);
  background-color: rgba(146, 207, 194, 0.109);
  margin-top: 10rpx;
}

.content {
  padding: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #0b988f;
  margin: 30rpx 0 20rpx 0;
}

.content-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  margin-bottom: 30rpx;
  white-space: pre-wrap;
}

