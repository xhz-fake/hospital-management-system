.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 60rpx 40rpx 120rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-banner {
  width: 100%;
  background: linear-gradient(135deg, #0b988f, #24b7ae);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  color: #fff;
}

.success-banner .icon {
  width: 72rpx;
  height: 72rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.success-banner .title {
  font-size: 40rpx;
  font-weight: bold;
}

.info-card {
  width: 100%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.doctor-section {
  display: flex;
  align-items: center;
}

.doctor-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.doctor-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.doctor-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.doctor-title {
  font-size: 28rpx;
  color: #0b988f;
}

.department {
  font-size: 26rpx;
  color: #666;
}

.divider {
  margin: 30rpx 0;
  height: 1rpx;
  background-color: #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
}

.value {
  color: #333;
  font-weight: 500;
}

.actions {
  margin-top: auto;
  width: 100%;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.btn.primary {
  background-color: #0b988f;
  color: #fff;
}

.btn.secondary {
  background-color: #fff;
  color: #0b988f;
  border: 2rpx solid #0b988f;
}


