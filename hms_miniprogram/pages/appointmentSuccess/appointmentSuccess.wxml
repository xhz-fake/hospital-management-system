<view class="container">
  <view class="success-banner">
    <view class="icon">✓</view>
    <text class="title">预约成功</text>
  </view>

  <view class="info-card">
    <view class="doctor-section">
      <image class="doctor-avatar" src="{{info.doctorAvatar || '/assets/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="doctor-details">
        <text class="doctor-name">{{info.doctorName || '医生'}}</text>
        <text class="doctor-title">{{info.doctorTitle || ''}}</text>
        <text class="department">{{info.departmentName || ''}}</text>
      </view>
    </view>

    <view class="divider"></view>

    <view class="info-row">
      <text class="label">就诊时间</text>
      <text class="value">{{displayTime}}</text>
    </view>
    <view class="info-row">
      <text class="label">挂号诊金</text>
      <text class="value">¥{{info.fee || 91}}</text>
    </view>
    <view class="info-row">
      <text class="label">挂号单号</text>
      <text class="value">{{info.orderNumber || '待生成'}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="btn secondary" bindtap="goHome">返回首页</button>
    <button class="btn primary" bindtap="viewAppointments">查看预约详情</button>
  </view>
</view>


