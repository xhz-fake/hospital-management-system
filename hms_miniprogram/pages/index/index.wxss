/* pages/index/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.hospital-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #0b988f;
}

/* 搜索框样式 */
.search-box {
  position: relative;
  margin: 30rpx 0;
  background-color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 60rpx 20rpx 30rpx;
}

.search-input {
  width: 100%;
  height: 60rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
}

/* 就诊人轮播图样式 */
.patient-swiper-section {
  margin: 40rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-patient-btn {
  color: #0b988f;
  font-size: 26rpx;
}

.patient-swiper {
  height: 200rpx;
}

.patient-card {
  background: linear-gradient(135deg, #0b988f 0%, #0a7d75 100%);
  border-radius: 16rpx;
  padding: 40rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
}

.patient-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.patient-id-card {
  font-size: 28rpx;
  opacity: 0.9;
}

.empty-card {
  background-color: #f0f0f0;
  color: #999;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 互联网医院模块 */
.internet-hospital-section,
.hospital-info-section {
  margin: 40rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.function-grid,
.info-grid {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
}

.function-item,
.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.function-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.info-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.function-item text,
.info-item text {
  font-size: 24rpx;
  color: #333;
}

