/* pages/doctorDetail/doctorDetail.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f5f5;
}

.doctor-header {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.doctor-avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.doctor-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.doctor-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.doctor-title {
  font-size: 28rpx;
  color: #0b988f;
  margin-bottom: 10rpx;
}

.doctor-department {
  font-size: 26rpx;
  color: #666;
}

.tabs {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
}

.tab-item.active {
  background-color: #0b988f;
  color: #fff;
}

.tab-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.info-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
}

.date-slider {
  margin-bottom: 40rpx;
}

.date-scroll {
  white-space: nowrap;
}

.date-item {
  display: inline-block;
  padding: 20rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  text-align: center;
}

.date-item.active {
  background-color: #0b988f;
  color: #fff;
}

.date-text {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.date-week {
  display: block;
  font-size: 24rpx;
}

.time-section {
  margin-top: 40rpx;
}

.time-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 30rpx;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.time-item {
  padding: 25rpx 20rpx;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.time-item.active {
  border-color: #0b988f;
  background-color: #0b988f;
  color: #fff;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  padding: 25rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  border: none;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background-color: #0b988f;
  color: #fff;
}

