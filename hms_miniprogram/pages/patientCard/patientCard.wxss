/* pages/patientCard/patientCard.wxss */
.container {
  padding: 40rpx;
  background-color: #f5f5f5;
}

.patient-card {
  background: linear-gradient(135deg, #0b988f 0%, #0a7d75 100%);
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  color: #fff;
}

.hospital-name {
  display: block;
  font-size: 32rpx;
  margin-bottom: 40rpx;
  text-align: center;
}

.patient-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.patient-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.patient-id {
  font-size: 32rpx;
  opacity: 0.9;
}

